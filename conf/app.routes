# microservice specific routes

GET        /service-review/:service             uk.gov.hmrc.platformreadinessspike.controllers.ServiceReviewController.getServiceReview(service)
PUT        /service-review/                     uk.gov.hmrc.platformreadinessspike.controllers.ServiceReviewController.setServiceReview()

GET        /current-questions/:service          uk.gov.hmrc.platformreadinessspike.controllers.QuestionController.getCurrentQuestions(service)
POST       /question/                           uk.gov.hmrc.platformreadinessspike.controllers.QuestionController.insertQuestion()
